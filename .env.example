# Пример настроек для запуска бота у себя: cp .env.example .env && npm run bot
# На Railway и Vercel переменные задаются в настройках проекта, этот файл там не нужен.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Адрес папки webapp/ (https). На Railway и Vercel НЕ задавать — адрес определяется сам.
# Нужен только если игра лежит на другом хостинге, например:
# WEBAPP_URL=https://example.com/webapp/

# Необязательно:
# BUTTON_TEXT=🎮 Играть
# MENU_TEXT=Играть
# CAPTION=<b>Звезда провинции</b> — мини-игра прямо в Telegram.\nЖми «Играть» 👇
