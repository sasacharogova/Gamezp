# Этот файл нужен только для запуска бота у себя: cp .env.example .env && npm run bot
# На Vercel те же переменные задаются в настройках проекта (Settings → Environment Variables).

# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAA-your-token-here

# Где опубликована папка webapp/ (обязательно https):
WEBAPP_URL=https://gamezp.vercel.app/webapp/

# Необязательно:
# BUTTON_TEXT=🎮 Играть
# MENU_TEXT=Играть
# CAPTION=<b>Звезда провинции</b> — мини-игра прямо в Telegram.\nЖми «Играть» 👇
